# Copy this file to server/.env and fill in your real values.
# server/.env is git-ignored -- never commit the real connection string.

# Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/timecount

# MongoDB Atlas (Cluster -> Connect -> Drivers):
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/timecount?retryWrites=true&w=majority

PORT=4000
